# External researcher: auto prefers standalone OpenCode, then Hermes.
AI_NEWS_RESEARCH_BACKEND=auto
AI_NEWS_OPENCODE_MODEL=opencode-go/mimo-v2.5-pro

# Hermes is optional and project-isolated. Run scripts/setup-hermes-ainews.
AI_NEWS_HERMES_HOME=.hermes/profiles/ainews
HERMES_PROVIDER=opencode-go
HERMES_MODEL=mimo-v2.5-pro
HERMES_MAX_TURNS=12

# Optional discovery surfaces exposed to the research agent.
AI_NEWS_SEARXNG_URL=http://127.0.0.1:8889
AI_NEWS_SEARXNG_SEARCH_URL=http://127.0.0.1:8889/search
EXA_API_KEY=
BROWSE_CLI=browse

# Optional native microphone transcription.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional bounded Kokoro voice notes through /v1/audio/speech.
AI_NEWS_ENABLE_VOICE=1
KOKORO_TTS_BASE_URL=http://127.0.0.1:8890
KOKORO_API_KEY=
KOKORO_TTS_MODEL=kokoro
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_SPEED=1.0
AI_NEWS_VOICE_SYNTH_TIMEOUT=45
AI_NEWS_AUDIO_PLAYER=
AI_NEWS_AUDIO_PLAY_TIMEOUT=20
AI_NEWS_VOICE_DEDUPE_SECONDS=20
AI_NEWS_VOICE_NOTE_INTERVAL=35
AI_NEWS_VOICE_NOTE_LIMIT=2
AI_NEWS_VOICE_NOTE_MAX_AGE=12
AI_NEWS_VOICE_NOTE_MAX_CHARS=110
