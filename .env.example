# Hermes is the sole research runtime; configure its provider through Ctrl+,.
HERMES_MAX_TURNS=12

# Discovery credentials and the SearXNG endpoint are configured only through
# Connections (Ctrl+,); Browse is discovered on PATH.

# Optional bounded Kokoro voice notes through /v1/audio/speech.
AI_NEWS_ENABLE_VOICE=1
KOKORO_TTS_BASE_URL=http://127.0.0.1:8890
KOKORO_API_KEY=
KOKORO_TTS_MODEL=kokoro
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_SPEED=1.0
AI_NEWS_VOICE_SYNTH_TIMEOUT=45
AI_NEWS_AUDIO_PLAYER=
AI_NEWS_AUDIO_PLAY_TIMEOUT=20
AI_NEWS_VOICE_DEDUPE_SECONDS=20
AI_NEWS_VOICE_NOTE_INTERVAL=35
AI_NEWS_VOICE_NOTE_LIMIT=2
AI_NEWS_VOICE_NOTE_MAX_AGE=12
AI_NEWS_VOICE_NOTE_MAX_CHARS=110
