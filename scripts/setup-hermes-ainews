#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
command -v hermes >/dev/null 2>&1 || {
  printf 'Hermes is not installed; saved-canvas operation does not require it.\n' >&2
  exit 2
}

profile=ainews
root=$PWD/.hermes
home=$root/profiles/$profile
template=$PWD/hermes/$profile
mkdir -p "$root"

export HERMES_HOME=$root
if ! hermes profile list | grep -qE "(^|[[:space:]])${profile}([[:space:]]|$)"; then
  hermes profile create "$profile" --no-skills --no-alias \
    --description "Isolated research agent for the native Not News canvas."
fi

mkdir -p "$home/memories"
touch "$home/.no-bundled-skills"
export HERMES_HOME=$home
unset HERMES_PROFILE
hermes skills opt-out --remove --yes >/dev/null

install -m 600 "$template/config.yaml" "$home/config.yaml"
install -m 600 "$template/SOUL.md" "$home/SOUL.md"
install -m 600 "$template/memories/USER.md" "$home/memories/USER.md"

printf 'Hermes profile home: %s\n' "$home"
printf 'Credentials remain private; authenticate this exact HERMES_HOME if required.\n'
