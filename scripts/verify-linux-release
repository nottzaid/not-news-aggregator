#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
version=$(cargo metadata --no-deps --filter-platform x86_64-unknown-linux-gnu --format-version 1 | jq -r '.packages[] | select(.name == "not-news-app") | .version')
appimage="$root/dist/not-news_${version}_linux-x86_64.AppImage"
deb="$root/dist/not-news_${version}_linux-x86_64.deb"
archive="$root/dist/not-news_${version}_linux-x86_64.tar.xz"
runtime="$root/dist/RUNTIME-linux-x86_64.json"
expected_commit=$(git rev-parse HEAD)

rm -f "$runtime"
sed -i '/  RUNTIME-linux-x86_64\.json$/d' "$root/dist/SHA256SUMS-linux-x86_64.txt"

for artifact in \
  "$appimage" \
  "$deb" \
  "$archive" \
  "$root/dist/BUILDINFO-linux-x86_64.json" \
  "$root/dist/DEPENDENCIES-linux-x86_64.json" \
  "$root/dist/SHA256SUMS-linux-x86_64.txt"; do
  test -f "$artifact" || {
    echo "missing release artifact: $artifact" >&2
    exit 1
  }
done
(cd dist && sha256sum -c SHA256SUMS-linux-x86_64.txt)
jq -e --arg commit "$(git rev-parse HEAD)" \
  '.commit == $commit and .packager == "cargo-packager 0.11.8"' \
  dist/BUILDINFO-linux-x86_64.json >/dev/null
jq -e \
  '.packages | length > 0 and all(.[]; has("name") and has("version") and has("license"))' \
  dist/DEPENDENCIES-linux-x86_64.json >/dev/null

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

present() {
  if [[ -n ${WAYLAND_DISPLAY:-} || -n ${DISPLAY:-} ]]; then
    "$@"
  elif command -v xvfb-run >/dev/null; then
    xvfb-run --auto-servernum "$@"
  else
    echo "a compositor or xvfb-run is required for native presentation evidence" >&2
    exit 1
  fi
}

assert_self_check() {
  jq -e --arg commit "${expected_commit:0:12}" --arg renderer "$2" \
    '.release_self_check == "pass" and .commit == $commit and
     (if $renderer == "auto" then (.renderer == "skia-opengl" or .renderer == "skia-raster") else .renderer == $renderer end)' \
    <<<"$1" >/dev/null
}

cp "$appimage" "$scratch/relocated-not-news.AppImage"
chmod +x "$scratch/relocated-not-news.AppImage"
appimage_auto=$(APPIMAGE_EXTRACT_AND_RUN=1 present \
  "$scratch/relocated-not-news.AppImage" \
  --release-self-check "$scratch/appimage-check")
printf '%s\n' "$appimage_auto"
assert_self_check "$appimage_auto" auto
appimage_software=$(NOT_NEWS_FORCE_SOFTWARE=1 APPIMAGE_EXTRACT_AND_RUN=1 present \
  "$scratch/relocated-not-news.AppImage" \
  --release-self-check "$scratch/appimage-software-check")
printf '%s\n' "$appimage_software"
assert_self_check "$appimage_software" skia-raster
appimage_capabilities=$(APPIMAGE_EXTRACT_AND_RUN=1 \
  "$scratch/relocated-not-news.AppImage" \
  --capability-check "$scratch/capabilities")
printf '%s\n' "$appimage_capabilities"
jq -e --arg commit "${expected_commit:0:12}" \
  '.capability_check == "pass" and .commit == $commit and
   (.research.selected_ready | type == "boolean") and
   (.transcription.os_vault_probe | type == "string") and
   (.microphone.state | type == "string") and
   (.kokoro.state | type == "string")' \
  <<<"$appimage_capabilities" >/dev/null

mkdir "$scratch/deb"
(
  cd "$scratch/deb"
  ar x "$deb"
  tar -xzf data.tar.gz
)
cmp target/release/not-news-app "$scratch/deb/usr/bin/not-news-app"
grep -Fx 'Name=Not News' "$scratch/deb/usr/share/applications/not-news-app.desktop"
grep -Fx 'Icon=not-news-app' "$scratch/deb/usr/share/applications/not-news-app.desktop"
deb_auto=$(present \
  "$scratch/deb/usr/bin/not-news-app" \
  --release-self-check "$scratch/deb-check")
printf '%s\n' "$deb_auto"
assert_self_check "$deb_auto" auto

mkdir "$scratch/archive"
tar -xJf "$archive" -C "$scratch/archive"
portable="$scratch/archive/not-news_${version}_linux-x86_64/not-news-app"
cmp target/release/not-news-app "$portable"
archive_auto=$(present "$portable" --release-self-check "$scratch/archive-check")
printf '%s\n' "$archive_auto"
assert_self_check "$archive_auto" auto

jq -n \
  --arg commit "$expected_commit" \
  --argjson appimage_auto "$appimage_auto" \
  --argjson appimage_software "$appimage_software" \
  --argjson appimage_capabilities "$appimage_capabilities" \
  --argjson deb_auto "$deb_auto" \
  --argjson archive_auto "$archive_auto" \
  '{schema: 1, commit: $commit, appimage_auto: $appimage_auto, appimage_software: $appimage_software, appimage_capabilities: $appimage_capabilities, deb_auto: $deb_auto, archive_auto: $archive_auto}' \
  > "$runtime"
(
  cd dist
  sha256sum RUNTIME-linux-x86_64.json >> SHA256SUMS-linux-x86_64.txt
)
