#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
binary="$root/dist/not-news-linux-x86_64"
expected_commit=${GITHUB_SHA:-$(git rev-parse HEAD)}

test -x "$binary"
test "$(find dist -maxdepth 1 -type f | wc -l)" -eq 1
file "$binary" | grep -Fq 'ELF 64-bit LSB'
file "$binary" | grep -Fq 'dynamically linked'

needed=$(readelf -d "$binary" | sed -n 's/.*Shared library: \[\(.*\)\]/\1/p')
unexpected=$(grep -Ev '^(libc\.so\.6|libm\.so\.6|libdl\.so\.2|libpthread\.so\.0|librt\.so\.1|ld-linux-x86-64\.so\.2)$' <<<"$needed" || true)
if test -n "$unexpected"; then
  printf 'unexpected shared-library dependencies:\n%s\n' "$unexpected" >&2
  exit 1
fi
for forbidden in libasound libstdc++ libgcc_s libfreetype libfontconfig libpng libbrotli libbz2 libexpat; do
  ! grep -Fq "$forbidden" <<<"$needed" || {
    echo "$forbidden leaked into the single-ELF runtime boundary" >&2
    exit 1
  }
done

maximum_glibc=$(objdump -T "$binary" | grep -Eo 'GLIBC_[0-9]+\.[0-9]+' | sort -Vu | tail -1)
if test "$(printf '%s\n' GLIBC_2.31 "$maximum_glibc" | sort -Vu | tail -1)" != GLIBC_2.31; then
  echo "the ELF requires $maximum_glibc; the release ceiling is GLIBC_2.31" >&2
  exit 1
fi

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cp "$binary" "$scratch/not-news"
chmod 0755 "$scratch/not-news"
cmp "$binary" "$scratch/not-news"

present() {
  if [[ -n ${WAYLAND_DISPLAY:-} || -n ${DISPLAY:-} ]]; then
    "$@"
  elif command -v xvfb-run >/dev/null; then
    xvfb-run --auto-servernum "$@"
  else
    echo "a compositor or xvfb-run is required for native presentation evidence" >&2
    exit 1
  fi
}

assert_self_check() {
  jq -e --arg commit "${expected_commit:0:12}" --arg renderer "$2" \
    '.release_self_check == "pass" and .empty_launch == true and .commit == $commit and
     (if $renderer == "auto" then (.renderer == "skia-opengl" or .renderer == "skia-raster") else .renderer == $renderer end)' \
    <<<"$1" >/dev/null
}

automatic=$(present "$scratch/not-news" --release-self-check "$scratch/automatic")
printf '%s\n' "$automatic"
assert_self_check "$automatic" auto
software=$(NOT_NEWS_FORCE_SOFTWARE=1 present "$scratch/not-news" --release-self-check "$scratch/software")
printf '%s\n' "$software"
assert_self_check "$software" skia-raster
capabilities=$(
  EXA_API_KEY=must-be-ignored \
  GROQ_API_KEY=must-be-ignored \
  BROWSERBASE_API_KEY=must-be-ignored \
  SEARXNG_URL=https://must-be-ignored.invalid \
  "$scratch/not-news" --capability-check "$scratch/capabilities"
)
printf '%s\n' "$capabilities"
jq -e --arg commit "${expected_commit:0:12}" \
  '.capability_check == "pass" and .commit == $commit and
   .research.runtime == "hermes" and .research.profile_policy == "installed-v2" and
   .discovery.searxng_endpoint == "missing" and
   .transcription.configuration == "deferred-os-vault-probe"' \
  <<<"$capabilities" >/dev/null
