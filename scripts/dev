#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export UV_CACHE_DIR="${UV_CACHE_DIR:-$PWD/.uv-cache}"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

scripts/doctor
scripts/setup-hermes-ainews >/dev/null
scripts/searxng start >/dev/null

scripts/backend &
backend_pid=$!
trap 'kill "$backend_pid" 2>/dev/null || true' EXIT

backend_url="http://127.0.0.1:${AI_NEWS_BACKEND_PORT:-8765}"
for _ in $(seq 1 100); do
  if curl -fsS "$backend_url/health" >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$backend_pid" 2>/dev/null; then
    wait "$backend_pid" || true
    echo "Backend exited before becoming ready." >&2
    exit 1
  fi
  sleep 0.1
done
curl -fsS "$backend_url/health" >/dev/null || {
  echo "Backend did not become healthy at $backend_url." >&2
  exit 1
}

flutter run -d linux --dart-define=AI_NEWS_GRAPH_STREAM_URL="$backend_url/graph/stream"
