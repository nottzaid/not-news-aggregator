#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

missing=0
for command in flutter uv hermes curl python; do
  if command -v "$command" >/dev/null 2>&1; then
    printf 'ok       %s\n' "$command"
  else
    printf 'missing  %s\n' "$command" >&2
    missing=1
  fi
done

if command -v podman >/dev/null 2>&1; then
  printf 'ok       podman (SearXNG runtime)\n'
elif command -v docker >/dev/null 2>&1; then
  printf 'ok       docker (SearXNG runtime)\n'
else
  printf 'missing  podman or docker (SearXNG runtime)\n' >&2
  missing=1
fi

if [[ ! -f .env ]]; then
  printf 'missing  .env (copy .env.example, then add private keys)\n' >&2
  missing=1
else
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
  printf 'ok       .env\n'
  if [[ "${AI_NEWS_ENABLE_HERMES:-0}" == 1 && \
        "${HERMES_PROVIDER:-opencode-go}" == opencode-go && \
        -z "${OPENCODE_GO_API_KEY:-}" ]]; then
    printf 'missing  OPENCODE_GO_API_KEY (Hermes is enabled with opencode-go)\n' >&2
    missing=1
  fi
  if [[ "${AI_NEWS_ENABLE_HERMES:-0}" == 1 && \
        -z "${EXA_API_KEY:-}" ]]; then
    printf 'missing  EXA_API_KEY (Hermes research is enabled)\n' >&2
    missing=1
  fi
  browse_command="${BROWSE_CLI:-browse}"
  if [[ "${AI_NEWS_ENABLE_HERMES:-0}" == 1 && \
        "${AI_NEWS_REQUIRE_SEARCH_TRIAD:-1}" == 1 ]]; then
    if command -v "$browse_command" >/dev/null 2>&1; then
      printf 'ok       %s (dynamic-page research)\n' "$browse_command"
    else
      printf 'missing  %s (search triad is required)\n' "$browse_command" >&2
      missing=1
    fi
  fi
  if [[ -z "${GROQ_API_KEY:-}" ]]; then
    printf 'optional GROQ_API_KEY is unset; microphone transcription will be unavailable\n'
  fi
fi

if (( missing )); then
  exit 1
fi

printf 'Development prerequisites: PASS\n'
