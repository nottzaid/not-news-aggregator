#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
static_root=${NOT_NEWS_STATIC_ROOT:-$root/target/release-static}
alsa_source_root="$static_root/src/alsa-lib"
alsa_commit=81d70a27136840fa8fb1bec6eb8e04fc1475a380
fontconfig_version=2.18.2
fontconfig_source_root="$static_root/src/fontconfig-$fontconfig_version"
fontconfig_archive="$static_root/src/fontconfig-$fontconfig_version.tar.xz"
fontconfig_sha256=cf8e6576ef0484c15079bdaf77cd9c51c464df5365814ada4d3ee7331ea31eb5
fontconfig_url="https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/$fontconfig_version/fontconfig-$fontconfig_version.tar.xz"

mkdir -p "$static_root/src"
if ! test -f "$static_root/lib/libasound.a"; then
  if ! test -d "$alsa_source_root/.git"; then
    git clone --filter=blob:none https://github.com/alsa-project/alsa-lib.git "$alsa_source_root"
  fi
  git -C "$alsa_source_root" fetch --depth=1 origin "$alsa_commit"
  git -C "$alsa_source_root" checkout --detach "$alsa_commit"
  test "$(git -C "$alsa_source_root" rev-parse HEAD)" = "$alsa_commit"

  (
    cd "$alsa_source_root"
    autoreconf --force --install
    ./configure \
      --prefix="$static_root" \
      --disable-shared \
      --enable-static \
      --disable-python
    make -j"$(getconf _NPROCESSORS_ONLN)"
    make install
  )
fi
test -f "$static_root/lib/libasound.a"

if ! test -f "$static_root/lib/libfontconfig.a"; then
  if ! test -f "$fontconfig_archive" || \
    ! echo "$fontconfig_sha256  $fontconfig_archive" | sha256sum --check --status; then
    curl --fail --location --show-error --output "$fontconfig_archive.download" \
      "$fontconfig_url"
    echo "$fontconfig_sha256  $fontconfig_archive.download" | sha256sum --check --status
    mv "$fontconfig_archive.download" "$fontconfig_archive"
  fi
  echo "$fontconfig_sha256  $fontconfig_archive" | sha256sum --check --status

  if ! test -x "$fontconfig_source_root/configure"; then
    if test -d "$fontconfig_source_root"; then
      find "$fontconfig_source_root" -depth -delete
    fi
    tar -xJf "$fontconfig_archive" -C "$static_root/src"
  fi
  test -x "$fontconfig_source_root/configure"

  (
    cd "$fontconfig_source_root"
    ./configure \
      --prefix="$static_root" \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --disable-shared \
      --enable-static \
      --disable-cache-build \
      --disable-docbook \
      --disable-docs \
      --disable-libxml2 \
      --disable-nls
    make -j"$(getconf _NPROCESSORS_ONLN)"
    mkdir -p "$static_root/lib"
    install -m 0644 src/.libs/libfontconfig.a "$static_root/lib/libfontconfig.a"
  )
fi
test -f "$static_root/lib/libfontconfig.a"
