#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

static_root=${NOT_NEWS_STATIC_ROOT:-$root/target/release-static}
command -v clang >/dev/null || {
  echo "clang is required for the release build" >&2
  exit 1
}
test -f "$static_root/lib/libasound.a" || {
  echo "missing $static_root/lib/libasound.a; run scripts/prepare-linux-release" >&2
  exit 1
}

for library in asound freetype fontconfig bz2 png16 z brotlidec brotlicommon expat; do
  if ! find "$static_root/lib" /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu \
    -maxdepth 2 -type f -name "lib${library}.a" -print -quit 2>/dev/null | grep -q .; then
    echo "a static lib${library}.a is required for the single-ELF release" >&2
    exit 1
  fi
done
for library in libstdc++.a libgcc_eh.a; do
  path=$(cc -print-file-name="$library")
  test "$path" != "$library" && test -f "$path" || {
    echo "the compiler's static $library is required for the single-ELF release" >&2
    exit 1
  }
done

commit=${GITHUB_SHA:-$(git rev-parse HEAD)}
export NOT_NEWS_BUILD_COMMIT=${commit:0:12}
export NOT_NEWS_STATIC_ROOT="$static_root"
export NOT_NEWS_SYSTEM_LINKER=clang
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$root/scripts/linux-release-linker"
export PKG_CONFIG_ALL_STATIC=1
export CC=clang
export CXX=clang++

rm -rf dist
mkdir -p dist
cargo build --locked --release -p not-news-app
cp target/release/not-news-app dist/not-news-linux-x86_64
chmod 0755 dist/not-news-linux-x86_64
strip --strip-unneeded dist/not-news-linux-x86_64
